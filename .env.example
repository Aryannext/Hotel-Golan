# Hotel Golán · variables de entorno (copie este archivo como .env y cambie los valores).
# .env NUNCA se sube al repositorio ni a herramientas de IA. Este ejemplo no contiene secretos reales.

# ---------- Base de datos (docker-compose.yml, ADR-004) ----------
# Usuario dueño de la base.
POSTGRES_USER=hotel_golan
# Contraseña larga y aleatoria. Ejemplo para generarla: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=cambie-esta-clave
# Nombre de la base.
POSTGRES_DB=hotel_golan
# Puerto local; solo escucha en 127.0.0.1. Si ya hay otro PostgreSQL en 5432 (pasa en el PC de desarrollo),
# use 5433 aquí y en DATABASE_URL.
POSTGRES_PORT=5432
# Cadena de conexión que usan los scripts y, más adelante, la API.
DATABASE_URL=postgres://hotel_golan:cambie-esta-clave@127.0.0.1:5432/hotel_golan

# ---------- Reglas y zona horaria ----------
# Zona horaria para las reglas de negocio (salida por franjas, turnos de 6:30, día del hotel). No cambiar.
ZONA_HORARIA_NEGOCIO=America/Bogota
# Versión del aviso de privacidad vigente. Se guarda con cada autorización (ADR-006). Formato AV-AAAA-MM.
AVISO_PRIVACIDAD_VERSION=AV-2026-10

# ---------- Datos de prueba (solo desarrollo; scripts/sembrar.ts) ----------
# PIN de 6 dígitos que reciben todos los usuarios sintéticos. Solo para pruebas locales; nunca en producción.
SEMILLA_PIN_PRUEBA=135790

# ---------- API (fase 3) ----------
# Puerto interno de la API; tailscale serve lo publica dentro de la red privada.
API_PUERTO=3000
# Secreto para firmar o derivar los tokens de sesión (mínimo 32 bytes aleatorios).
SESION_SECRETO=cambie-este-secreto-de-al-menos-32-caracteres

# ---------- Red privada (fase 4, ADR-002) ----------
# Clave de un solo uso de Tailscale para unir el VPS a la red privada. Se genera en el panel de Tailscale.
TS_AUTHKEY=

# ---------- Copias cifradas (fase 4, ADR-007) ----------
# Clave PÚBLICA de age con la que se cifran las copias (la privada se guarda fuera del servidor).
AGE_DESTINATARIO=
# Destino de rclone en Google Drive, por ejemplo: gdrive:hotel-golan-copias
RCLONE_DESTINO=
# Días que se conservan las copias (ADR-007: 30).
COPIAS_RETENCION_DIAS=30
